      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "AI Operations by Status",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(created_at, '$__interval') AS time,\n  status,\n  COUNT(*) AS count\nFROM app_events\nWHERE\n  created_at >= $__timeFrom()\n  AND created_at <= $__timeTo()\n  AND type IN ('AI_CLASSIFICATION', 'AI_DRAFT_GENERATED', 'FIND_SIMILAR')\nGROUP BY time, status\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "req/s",
            "fillOpacity": 20,
            "lineWidth": 2,
            "stacking": { "group": "A", "mode": "normal" }
