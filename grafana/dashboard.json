          "rawSql": "SELECT\n  $__timeGroup(created_at, '$__interval') AS time,\n  CASE WHEN type = 'AI_PROVIDER_FALLBACK' THEN 'fallback' ELSE 'failed' END AS category,\n  COUNT(*) AS count\nFROM app_events\nWHERE\n  created_at >= $__timeFrom()\n  AND created_at <= $__timeTo()\n  AND type IN ('AI_PROVIDER_FALLBACK', 'AI_PROVIDER_ERROR')\nGROUP BY time, category\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
